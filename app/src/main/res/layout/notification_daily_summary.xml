<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="20dp"
    android:background="@drawable/bg_notification_card">

    <ImageView
        android:id="@+id/notification_illustration"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_notification_summary"
        android:contentDescription="@string/notification_illustration_desc" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="20dp"
        android:layout_gravity="center_vertical">

        <TextView
            android:id="@+id/text_today_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notification_today_label"
            android:textColor="@color/notification_text_secondary"
            android:textSize="13sp"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/text_today_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹0"
            android:textColor="@color/notification_text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/text_month_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This month: ₹0"
            android:textColor="@color/notification_text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />

    </LinearLayout>

</LinearLayout>